<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Pode ser substituido por uma raiz UNC sem alterar o caminho local do SQLite. -->
		<add key="StorageRoot" value="C:\TeamOps" />
		<add key="DatabasePath" value="C:\TeamOps\DB\teamops.db" />
		<add key="HikitsuguiAttachmentPath" value="Anexo\Hikitsugui" />
	</appSettings>
</configuration>
