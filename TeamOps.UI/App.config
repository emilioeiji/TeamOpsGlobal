<configuration>
	<appSettings>
		<!-- Raiz dos documentos e integracoes. Em producao, pode ser UNC: \\servidor\compartilhamento\TeamOps -->
		<add key="StorageRoot" value="C:\TeamOps" />

		<!-- SQLite permanece local e independente de StorageRoot. -->
		<add key="DatabasePath" value="C:\TeamOps\DB\teamops.db" />

		<!-- Diretório onde os PR serão salvos -->
		<add key="PRDirectory" value="PR" />

		<!-- Caminho do arquivo modelo -->
		<add key="PRTemplate" value="Modelos\ModeloPR.xlsx" />

		<!-- Diretório onde os CL serão salvos -->
		<add key="CLDirectory" value="CL" />

		<!-- Caminho do arquivo modelo -->
		<add key="CLTemplate" value="Modelos\ModeloCL.xlsx" />

		<!-- Diretório onde os anexos do Hikitsugui serão salvos -->
		<add key="HikitsuguiAttachmentPath" value="Anexo\Hikitsugui" />

		<!-- Diretório onde ficam os arquivos CSV de schedule -->
		<add key="OperatorScheduleDirectory" value="Schedule" />

		<!-- Diretório onde o Haidai HTML será exportado para TV -->
		<add key="HaidaiExportDirectory" value="Haidai" />

		<!-- Diretório final onde o TeamOps lê os TXT de eventos -->
		<add key="ProductionEventsDirectory" value="Production\Events" />

		<!-- Diretório de origem dos arquivos de eventos usado pelo BAT -->
		<add key="ProductionSourceEventsDirectory" value="Production\Source\Events" />

		<!-- Diretório de origem dos arquivos .dat usado pelo BAT -->
		<add key="ProductionSourceDatDirectory" value="Production\Source\Dat" />

		<!-- BAT responsável por copiar/sincronizar os arquivos antes da importação -->
		<add key="ProductionImportBatchPath" value="Production\import-production.bat" />

		<!-- Arquivo sinalizado pelo BAT quando a cópia terminar -->
		<add key="ProductionImportCompletionFile" value="Production\import.done" />

		<!-- Timeout da execução do BAT em segundos -->
		<add key="ProductionImportTimeoutSeconds" value="180" />

		<!-- Arquivo exportado pelo EC2 Administrator. -->
    <add key="Ec2AdministratorFilePath" value="Samples\EC2_Administrator_sample.dat" />

		<!-- Minutos de parada no EC2 para desconsiderar a maquina do calculo produtivo. -->
		<add key="MachineStoppedIgnoreAfterMinutes" value="0" />

		<!-- Palavras que indicam maquina operando no arquivo EC2 Administrator. -->
		<add key="Ec2AdministratorRunningStatusKeywords" value="operando,rodando,running,run,稼働,運転,稼働中,運転中" />
	</appSettings>
</configuration>
